APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# In production set this to your public URL, e.g. https://portfolio.example.com
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Set to "true" to run `php artisan migrate --force` on container start (Dokku)
RUN_MIGRATIONS=false

# GitHub API
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# EmailJS (read server-side via env() in connect.blade.php)
VITE_EMAILJS_SERVICE_ID=service_xxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxx

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# Contact form destination email
CONTACT_EMAIL=youremail@gmail.com
